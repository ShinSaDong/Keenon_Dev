# 복사해서 .env 로 사용:  cp .env.example .env
DATABASE_URL=sqlite:///./data/control.db
ROBOT_LINK=local
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=kr/robot
# 앱/외부 시스템이 쓰는 Open API 계정 (id:secret, 쉼표로 여러 개)
OPEN_CLIENTS=demo-client:demo-secret
TOKEN_TTL_SECONDS=7200
WEBHOOK_URLS=
OFFLINE_TIMEOUT_SECONDS=30
SEED_DEMO=true
